# Environment variables for what-should-we-eat
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

DATABASE_URL=postgresql://recipes_user:recipes_pass@localhost:5432/recipes_db

# Security
SECRET_KEY=yoursecretkeyhere
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DEMO_HOUSEHOLD_ID=1

# Exact public HTTPS origin for passkeys (localhost HTTP is allowed for development).
APP_BASE_URL=https://onionary.malaber.de
# Temporary migration compatibility only. The native app always uses passkeys.
ALLOW_LEGACY_PASSWORD_AUTH=false
